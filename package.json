{
  "name": "dev-to-dev",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "content": "tsx scripts/build-content.ts",
    "favicons": "tsx scripts/fetch-favicons.ts",
    "check-links": "tsx scripts/check-links.ts",
    "prestart": "npm run content",
    "start": "ng serve",
    "prebuild": "npm run content",
    "build": "ng build",
    "postbuild": "tsx scripts/postbuild.ts",
    "watch": "ng build --watch --configuration development",
    "pretest": "npm run content",
    "test": "ng test --watch=false",
    "lint": "ng lint",
    "typecheck": "tsc -p scripts/tsconfig.json && tsc -p e2e/tsconfig.json --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "preview": "npx --yes serve dist/dev-to-dev/browser"
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@shikijs/transformers": "^4.6.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^22.12.0",
    "angular-eslint": "22.6.0",
    "eslint": "^10.12.0",
    "jsdom": "^31.0.0",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.7",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=22.12"
  }
}
